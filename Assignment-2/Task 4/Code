#include <iostream>
#include <string>
using namespace std;

class SavingsAccount
{
private:
    int accountNumber;
    double balance;
    string transactions[10];
    int count;
    int nextIndex;

public:
    SavingsAccount(int accNo, double initialBalance)
    {
        accountNumber = accNo;
        balance = initialBalance;
        count = 0;
        nextIndex = 0;
    }

    void deposit(double amount);
    void withdraw(double amount);
    void miniStatement() const;
};

void SavingsAccount::deposit(double amount)
{
    if (amount <= 0)
    {
        cout << "Invalid deposit\n";
        return;
    }

    balance += amount;

    transactions[nextIndex] = "Deposited: " + to_string(amount);
    nextIndex = (nextIndex + 1) % 10;

    if (count < 10)
        count++;
}

void SavingsAccount::withdraw(double amount)
{
    if (amount <= 0 || amount > balance)
    {
        cout << "Invalid withdrawal\n";
        return;
    }

    balance -= amount;

    transactions[nextIndex] = "Withdrawn: " + to_string(amount);
    nextIndex = (nextIndex + 1) % 10;

    if (count < 10)
        count++;
}

void SavingsAccount::miniStatement() const
{
    cout << "\nAccount Number: " << accountNumber << '\n';
    cout << "Balance: " << balance << '\n';
    cout << "Last Transactions:\n";

    int start = (count == 10) ? nextIndex : 0;

    for (int i = 0; i < count; i++)
    {
        int index = (start + i) % 10;
        cout << transactions[index] << '\n';
    }
}

int main()
{
    SavingsAccount account(1001, 5000);

    account.deposit(1000);
    account.withdraw(500);
    account.deposit(200);
    account.withdraw(100);

    for (int i = 1; i <= 8; i++)
        account.deposit(i * 100);

    account.miniStatement();

    return 0;
}
