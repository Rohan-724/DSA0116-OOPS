#include <iostream>
using namespace std;

class Token
{
    static int next;
    int id;

public:
    Token()
    {
        id = ++next;
    }

    int get() const
    {
        return id;
    }

    static int issued()
    {
        return next - 100;
    }
};

int Token::next = 100;

int main()
{
    Token counter[3];
    Token extra;

    cout << "Token Details\n";
    cout << "-------------\n";

    cout << "First token: " << counter[0].get() << endl;
    cout << "Third token: " << counter[2].get() << endl;
    cout << "Extra token: " << extra.get() << endl;

    cout << "Total issued: " << Token::issued() << endl;

    return 0;
}
