#include <iostream>
using namespace std;

struct Parcel
{
    double weight;
    bool express;
    bool insured;
};

double charge(int grams, bool express = false)
{
    double total = 40 + (grams / 1000.0) * 20;

    if (express)
        total += 30;

    return total;
}

double charge(double kg, bool express = false, bool insured = false)
{
    double total = 40 + kg * 20;

    if (express)
        total += 30;

    if (insured)
        total += 15;

    return total;
}

double charge(Parcel p)
{
    return charge(p.weight, p.express, p.insured);
}

int main()
{
    cout << charge(2) << '\n';
    cout << charge(2.0) << '\n';
    cout << charge(2.0f) << '\n';
    cout << charge(2000, true) << '\n';
    cout << charge(2.5, true, true) << '\n';

    Parcel p = {3.0, false, true};
    cout << charge(p) << '\n';

    return 0;
}
