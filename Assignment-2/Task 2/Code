#include <iostream>
using namespace std;

int& highestMark(int marks[], int size)
{
    int highest = 0;

    for (int i = 1; i < size; i++)
    {
        if (marks[i] > marks[highest])
            highest = i;
    }

    return marks[highest];
}

// This function demonstrates a dangerous dangling reference.
// Do not call it.
int& dangerousFunction()
{
    int local = 50;
    return local;
}

const int& highestMarkConst(const int marks[], int size)
{
    int highest = 0;

    for (int i = 1; i < size; i++)
    {
        if (marks[i] > marks[highest])
            highest = i;
    }

    return marks[highest];
}

int main()
{
    int marks[] = {75, 88, 92, 81, 95};
    int size = 5;

    cout << "Highest mark: " << highestMark(marks, size) << '\n';

    highestMark(marks, size) += 2;

    cout << "After moderation: "
         << highestMark(marks, size) << '\n';

    cout << "Using const reference: "
         << highestMarkConst(marks, size) << '\n';

    int highestIndex = 0;

    for (int i = 1; i < size; i++)
    {
        if (marks[i] > marks[highestIndex])
            highestIndex = i;
    }

    cout << "Highest mark using index: "
         << marks[highestIndex] << '\n';

    return 0;
}
